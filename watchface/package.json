{
  "name": "weather-glance",
  "author": "Manapart",
  "version": "1.0.2",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.1.0"
  },
  "pebble": {
    "displayName": "Weather Glance",
    "uuid": "cc8c22c1-fb2d-467c-8fc1-16fe140712e7",
    "projectType": "moddable",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "capabilities": [
      "location",
      "configurable"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "ready",
      "weather",
      "weatherRequest",
      "timeText",
      "timeBackground",
      "nameText",
      "nameBackground",
      "normalWeather",
      "sleepModeEnabled",
      "useFahrenheit",
      "hotThresh",
      "warmThresh",
      "normalThresh"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "GENERIC_WEATHER",
          "file": "partly-cloudy.pdc"
        },
        {
          "type": "raw",
          "name": "HEAVY_RAIN",
          "file": "rain-heavy.pdc"
        },
        {
          "type": "raw",
          "name": "HEAVY_SNOW",
          "file": "snow-heavy.pdc"
        },
        {
          "type": "raw",
          "name": "LIGHT_RAIN",
          "file": "rain-light.pdc"
        },
        {
          "type": "raw",
          "name": "LIGHT_SNOW",
          "file": "snow-light.pdc"
        },
        {
          "type": "raw",
          "name": "PARTLY_CLOUDY",
          "file": "cloudy.pdc"
        },
        {
          "type": "raw",
          "name": "SUNNY_DAY",
          "file": "sunny.pdc"
        }
      ]
    }
  },
  "devDependencies": {
    "@moddable/typings": "^9.5.0"
  }
}
